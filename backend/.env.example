# Required by langchain-openai when the Research Node invokes the model.
OPENAI_API_KEY=your_api_key_here

# Optional: defaults to gpt-4.1-mini. For an OpenAI-compatible provider,
# use the model ID accepted by that provider (normally without "openai/").
OPENAI_MODEL=gpt-4.1-mini

# Optional: leave unset to use OpenAI. Example third-party compatibility URL:
OPENAI_BASE_URL=https://aihubmix.com/v1
